        "light": "{color.warn.light}",
        "ansi16": "33"
      },
      "danger": {
        "dark": "{color.danger.dark}",
        "light": "{color.danger.light}",
        "ansi16": "31"
      },
      "info": {
        "dark": "{color.info.dark}",
        "light": "{color.info.light}",
        "ansi16": "0"
      },
      "ember": {
        "dark": "{color.ember}",
        "light": "{color.ember-ink}",
        "ansi16": "93"
      },
      "ember-bright": {
        "dark": "{color.ember-bright}",
        "light": "{color.ember-ink}",
        "ansi16": "93"
      },
      "ember-ink": {
        "dark": "{color.ember}",
        "light": "{color.ember-ink}",
        "ansi16": "93"
      },
      "ash-400": {
        "dark": "{color.ash-400}",
        "light": "{color.ash-500}",
        "ansi16": "2"
      },
      "bold": {
        "attribute": "1"
      }
    }
